-- Timestamp: 2026-11-22_11-53-08 +05:30
import RuleTable
import Std

/-!
# Emit the AOT rule table (NF-01)

Run from this directory with `lake exe emitRules`. The command writes a text
manifest and a C header from `Sheaf.RuleTable.entries`. The Rust drift gate
parses the header and compares it with its own table.
-/

namespace Sheaf.RuleTable.Emit

def renderEntry (entry : Nat Ã— String Ã— String) : String :=
  "  { " ++ toString entry.1 ++ ", \"" ++ entry.2.1 ++ "\", \"" ++ entry.2.2 ++ "\" },"

def renderManifestEntry (entry : Nat Ã— String Ã— String) : String :=
  toString entry.1 ++ " " ++ entry.2.1 ++ " " ++ entry.2.2

def manifest : String :=
  String.intercalate "\n" (Sheaf.RuleTable.entries.map renderManifestEntry) ++ "\n"

def header : String :=
  "/* Generated by `lake exe emitRules`. Do not edit by hand. */\n" ++
  "#ifndef SHEAF_VERIFIED_RULES_GENERATED_H\n" ++
  "#define SHEAF_VERIFIED_RULES_GENERATED_H\n\n" ++
  "#define SHEAF_RULE_COUNT " ++ toString Sheaf.RuleTable.entries.length ++ "u\n" ++
  "#define SHEAF_RULE_DIGEST " ++ toString Sheaf.RuleTable.digest ++ "u\n\n" ++
  "typedef struct {\n" ++
  "  unsigned short id;\n" ++
  "  const char *name;\n" ++
  "  const char *theorem;\n" ++
  "} SheafVerifiedRule;\n\n" ++
  "static const SheafVerifiedRule SHEAF_VERIFIED_RULES[] = {\n" ++
  String.intercalate "\n" (Sheaf.RuleTable.entries.map renderEntry) ++ "\n" ++
  "};\n\n" ++
  "#endif /* SHEAF_VERIFIED_RULES_GENERATED_H */\n"

def main : IO Unit := do
  IO.FS.createDirAll "generated"
  IO.FS.createDirAll "../native/proofs-generated"
  IO.FS.writeFile "generated/verified_rules.txt" manifest
  IO.FS.writeFile "../native/proofs-generated/sheaf_verified_rules.generated.h" header
  IO.println ("emitted " ++ toString Sheaf.RuleTable.entries.length ++ " rules, digest " ++ toString Sheaf.RuleTable.digest)

end Sheaf.RuleTable.Emit

/-- The entry point that Lake runs with `lake exe emitRules`. -/
def main : IO Unit := Sheaf.RuleTable.Emit.main
