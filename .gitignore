# Environment & Credentials
.env
.env.local
*.token

# Protected neural-network archive. AGENTS.md forbids reading, indexing,
# copying, or using its Markdown files, so Git must not track them.
ARCHIVED_NEURAL_NETWORK_DOCUMENTATION/

# Python cache
__pycache__/
*.pyc

# Rust build artifacts
target/
**/target/
dist/
Cargo.lock

# Zig build artifacts
.zig-cache/
**/.zig-cache/
zig-out/
**/zig-out/

# Local protoc binary and protobuf includes for the gRPC code generator.
sheaf-db/tools/protoc/

# Local extraction of the attached benchmark bundle. The bundle stays local.
attached_bundle_review_*/

# Lean build artifacts: fetched Mathlib source and compiled proof objects.
# lake-manifest.json is committed because it pins the exact dependency revisions.
.lake/
**/.lake/

# Standalone rustc tools (built by tools/run_tools.sh, not cargo targets)
**/tools/*.exe
*.exe

# Logs
*.log
sheaf-db/tests/e2e/realtime_bench/results/*.log

# IDE / System
.vscode/
.idea/
Thumbs.db
Desktop.ini

# Local datasets (GBs, never commit)
data/
*.tsv
*.tsv.gz
*.zip
*.gz


# Session artifacts (large, not code)
fiber-bundle-build-avoidance-plan.json
html-conversation-to-timestamped-markdown.json

von-neumann-architecture-physical-limits.json
